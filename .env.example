# Puerto HTTP del BFF. Opcional; vale 4000.
PORT=4000
# development, production o test. Obligatoria: con production, la introspección y el landing
# del sandbox quedan apagados salvo GRAPHQL_INTROSPECTION=true.
NODE_ENV=development
# Cómo habla el BFF con el core. Obligatoria: grpc (servidor interno del core, GRPC_ENABLED=true)
# o rest (respaldo: lo único que expone el core en Render hasta la fase Azure).
CORE_TRANSPORT=grpc
# host:puerto del gRPC del core. Opcional; vale localhost:50051. Solo con CORE_TRANSPORT=grpc.
CORE_GRPC_URL=localhost:50051
# Origen del core por REST, sin ruta (el BFF agrega /flights/v1). Obligatoria con
# CORE_TRANSPORT=rest. Ej.: https://quinde-vuelos-api.onrender.com
CORE_REST_URL=
# Plazo de cada llamada al core, en milisegundos. Opcional; de 500 a 60000, vale 8000.
CORE_TIMEOUT_MS=8000
# Llamadas al core que puede costar una consulta; al pasarse, QUERY_TOO_EXPENSIVE.
# Opcional; de 1 a 1000, vale 10.
CORE_MAX_LLAMADAS_POR_CONSULTA=10
# Orígenes que pueden llamar al BFF desde un navegador (CORS), separados por coma, sin ruta ni
# barra final y sin "*". Opcional: vacía o ausente, ningún origen de navegador puede llamar.
# Ejemplo: CORS_ORIGINS=https://quinde.example.com,http://localhost:5173
CORS_ORIGINS=
# Proxies entre el cliente y el BFF, para que la IP del límite de peticiones sea la de
# X-Forwarded-For. false = ninguno (local); 1 = un proxy, como Render. "true" no se acepta.
TRUST_PROXY=false
# Introspección y landing del sandbox. Opcional: true fuera de production, false en production.
# GRAPHQL_INTROSPECTION=true
# Límites de peticiones por IP: duración de la ventana (segundos) y máximos por ventana. El global
# cuenta toda petición a /graphql; los demás, cada operación raíz. Opcionales; valen 60, 100, 20,
# 60 y 60. Al pasarse: TOO_MANY_REQUESTS con Retry-After.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
RATE_LIMIT_SEARCH_MAX=20
RATE_LIMIT_SEATMAP_MAX=60
RATE_LIMIT_FLIGHT_STATUS_MAX=60
