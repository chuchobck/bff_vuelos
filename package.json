{
  "name": "quinde-vuelos-bff",
  "version": "0.2.0",
  "description": "Quinde · BFF GraphQL de Vuelos: agrega las tres lecturas públicas del core (búsqueda, mapa de asientos y estado de vuelo) sobre gRPC, con REST de respaldo",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true",
    "proto:check": "node scripts/proto-check.cjs",
    "proto:sync": "node scripts/proto-sync.cjs",
    "schema:breaking": "bash scripts/schema-breaking.sh",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "test:mutaciones": "node scripts/mutaciones.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dataloader": "^2.2.3",
    "express": "^4.22.3",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@graphql-inspector/cli": "^7.0.1",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
